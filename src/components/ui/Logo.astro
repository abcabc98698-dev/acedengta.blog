---
import { siteConfig } from "@/config/site";
---

<a
  href="/"
  class="h-10 group relative z-30 flex items-center gap-2.5 text-neutral-900 dark:text-neutral-100 transition-transform duration-200 active:scale-95"
  aria-label={siteConfig.title}
>
  <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#2d6dc3] to-[#1a4a8d] flex items-center justify-center text-white shadow-md shadow-primary/20 border border-white/20 dark:border-white/10 group-hover:shadow-primary/30 transition-shadow">
    <!-- Modern Lighthouse Vector Emblem -->
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v3"/>
      <path d="M9 5h6l1 5H8l1-5z" fill="#fad13b" fill-opacity="0.3"/>
      <path d="M8 10l-2 11h12l-2-11"/>
      <path d="M9 15h6"/>
      <path d="M12 7v1"/>
      <circle cx="12" cy="7.5" r="1" fill="#ffffff"/>
      <path d="M5 4l2 2m12-2l-2 2" stroke="#fad13b"/>
    </svg>
  </div>
  <div class="flex flex-col">
    <span class="font-brand text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-none">
      {siteConfig.title}
    </span>
  </div>
</a>
