---
import { siteConfig } from "@/config/site";
---

<a
  href="/"
  class="h-10 group relative z-30 flex items-center gap-2.5 text-neutral-900 dark:text-neutral-100 transition-transform duration-200 active:scale-95"
  aria-label={siteConfig.title}
>
  <img
    src="/assets/logo.png"
    alt={siteConfig.title}
    width="36"
    height="36"
    class="w-9 h-9 rounded-full object-cover shadow-sm ring-1 ring-primary/20"
  />
  <div class="flex flex-col">
    <span class="font-brand text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 leading-none">
      {siteConfig.title}
    </span>
    <span class="text-[9px] tracking-wider text-primary dark:text-primary-light font-medium mt-0.5">
      官方正版授权
    </span>
  </div>
</a>
