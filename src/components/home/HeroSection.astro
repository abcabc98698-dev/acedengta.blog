---
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import AnimatedText from "@/components/ui/AnimatedText.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import { ArrowRight, ShieldCheck, Zap, Globe, Sparkles, Activity, CheckCircle2 } from "@lucide/astro";

const liveNodes = [
  { name: "香港 01 · IEPL 专线", ping: "12ms", speed: "2.48Gbps", status: "优选", tag: "极速" },
  { name: "日本 02 · 原生解锁", ping: "38ms", speed: "2.10Gbps", status: "推荐", tag: "4K流媒体" },
  { name: "新加坡 01 · 商业专线", ping: "45ms", speed: "2.35Gbps", status: "流畅", tag: "TikTok直播" },
  { name: "美国 05 · AI 专用节点", ping: "128ms", speed: "2.50Gbps", status: "满速", tag: "ChatGPT/Claude" },
];

const highlights = [
  { label: "运营历史", val: "自 2020 稳定运营" },
  { label: "专线架构", val: "全 IEPL / IPLC 专线" },
  { label: "连接协议", val: "新一代 VLESS 协议" },
  { label: "接入设备", val: "全套餐不限设备数" },
];
---

<div class="relative site-container z-20 w-full mx-auto mt-14 px-4 md:mt-18 lg:mt-24 xl:px-0">
  <div class="relative w-full px-2 sm:px-4 flex flex-col items-center justify-between lg:flex-row mb-16 gap-12">
    <!-- Left: Value Prop -->
    <div class="relative w-full lg:max-w-[560px] lg:w-1/2 text-center sm:text-left">
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
          <ShieldCheck size={14} />
          <span>官方正版授权 · 2020年稳定运营</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary dark:text-primary-light border border-primary/20">
          <Zap size={14} />
          <span>IEPL 企业专线 · VLESS 协议</span>
        </span>
      </div>

      <!-- Title -->
      <h1 class="mb-4">
        <span class="block text-2xl sm:text-3xl font-brand text-primary font-bold tracking-tight mb-2">
          灯塔加速器 · 官方品牌官网
        </span>
        <AnimatedText
          content="企业级 IEPL 专线，畅享全球原生网络"
          delay={0.1}
          duration={0.5}
          stagger={0.05}
          class="text-4xl text-neutral-900 dark:text-neutral-100 leading-tight sm:text-5xl lg:text-6xl font-brand font-bold"
        />
      </h1>

      <!-- Subtitle -->
      <div class="mb-8">
        <p class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
          始于 2020 年的老牌综合型加速品牌。依托全链路 IEPL / IPLC 商业内网专线与现代 VLESS 协议，原生覆盖港台日新美等全球优质线路。单节点最高 2.5Gbps，晚高峰超低时延抗拥堵，轻松解锁 4K 流媒体与 ChatGPT / TikTok 高要求业务。
        </p>
        <p class="mt-2 text-xs text-primary/90 dark:text-primary-light/90 font-medium">
          💡 年付轻量套餐低至 8.25 元/月（年付99元折算） · 不限设备同时连接 · 支持自研与 Clash/Shadowrocket 客户端
        </p>
      </div>

      <!-- CTA Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="500"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button
          url={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          type="fill"
          className="text-base px-6 py-3 font-semibold shadow-md shadow-primary/20"
        >
          <Sparkles size={16} /> 立即注册开通 <ArrowRight size={16} />
        </Button>
        <Button url="/#pricing" className="text-base px-6 py-3">
          查看套餐方案
        </Button>
      </div>

      <!-- Micro Trust Badges -->
      <div class="mt-8 pt-6 border-t border-dashed border-primary/15 dark:border-neutral-700/80 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
        {highlights.map((h) => (
          <div>
            <span class="block text-[11px] text-neutral-400">{h.label}</span>
            <span class="block text-xs font-semibold text-neutral-800 dark:text-neutral-200 mt-0.5">{h.val}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Real-time Node Status Monitor (Mock Dashboard) -->
    <div
      class="relative justify-end w-full lg:w-1/2 md:translate-y-2 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="200"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="acedengta.blog/dashboard" className="w-full">
        <div class="p-5 md:p-6 flex flex-col gap-4">
          <!-- Top Bar -->
          <div class="flex items-center justify-between pb-3 border-b border-primary/10 dark:border-neutral-700">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-bold text-neutral-800 dark:text-neutral-200">灯塔全球节点运行中枢</span>
            </div>
            <div class="flex items-center gap-2 text-[11px] text-neutral-400">
              <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">99.98% 可用率</span>
              <span class="font-mono">VLESS · IEPL</span>
            </div>
          </div>

          <!-- Live Nodes List -->
          <div class="space-y-2.5">
            <div class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider flex justify-between">
              <span>节点名称与线路类型</span>
              <span>时延 / 带宽</span>
            </div>
            {liveNodes.map((node) => (
              <div class="flex items-center justify-between p-3 rounded-xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/10 dark:border-neutral-700 hover:border-primary/30 transition-colors">
                <div class="flex items-center gap-2.5">
                  <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                  <div>
                    <span class="block text-xs font-semibold text-neutral-800 dark:text-neutral-100">{node.name}</span>
                    <span class="inline-block text-[10px] text-primary dark:text-primary-light font-medium">{node.tag}</span>
                  </div>
                </div>
                <div class="text-right">
                  <span class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">{node.ping}</span>
                  <span class="block text-[10px] text-neutral-400">{node.speed}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Bottom Speed Metric Card -->
          <div class="p-3.5 rounded-xl bg-gradient-to-r from-primary/10 via-primary/5 to-transparent border border-primary/15 dark:border-neutral-700 flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center">
                <Activity size={18} />
              </div>
              <div>
                <span class="block text-xs font-semibold text-neutral-800 dark:text-neutral-100">晚高峰抗卡顿引擎</span>
                <span class="block text-[10px] text-neutral-500 dark:text-neutral-400">独立企业内网专线 · 绝不挤公网拥堵隧道</span>
              </div>
            </div>
            <a
              href={REGISTER_URL}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="text-xs font-semibold text-primary dark:text-primary-light hover:underline flex items-center gap-1"
            >
              一键直连 <ArrowRight size={13} />
            </a>
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>
