---

<section id="pricing" class="pricing-section py-12 md:py-20 site-container">
  {showHeader && (
    <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16" data-aos="fade-up-xs" data-aos-once="true">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-medium mb-3">
        <Sparkles size={14} />
        <span>官方透明定价 · 拒绝套路</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-brand text-neutral-800 dark:text-neutral-100 tracking-tight">
        {title}
      </h2>
      <p class="mt-4 text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
        {description}
      </p>
    </div>
  )}

  <!-- 4-Card Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-7 items-stretch">
    {plans.map((plan, index) => (
      <div
        class:list={[
          "relative flex flex-col justify-between rounded-2xl p-6 sm:p-7 transition-all duration-300",
          plan.popular
            ? "bg-bg-secondary dark:bg-bg-secondary-dark border-2 border-primary shadow-[0_16px_40px_rgba(45,109,195,0.18)] dark:shadow-[0_16px_40px_rgba(0,0,0,0.35)] -translate-y-1.5"
            : "bg-bg-secondary/70 dark:bg-bg-secondary-dark/70 border border-primary/15 dark:border-neutral-700/80 hover:border-primary/40 hover:shadow-lg"
        ]}
        data-aos="fade-up-sm"
        data-aos-delay={index * 90}
        data-aos-once="true"
      >
        <!-- Top Badge -->
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-light border border-primary/20">
            {plan.badge}
          </span>
          {plan.popular && (
            <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-500 text-white shadow-sm">
              <Flame size={12} /> 推荐主力
            </span>
          )}
        </div>

        <!-- Plan Title & Price -->
        <div>
          <div class="flex items-baseline justify-between">
            <h3 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100">
              {plan.name}
            </h3>
            <span class="text-xs font-medium text-neutral-400 dark:text-neutral-500">
              {plan.subName}
            </span>
          </div>
          <p class="mt-2 text-xs text-neutral-500 dark:text-neutral-400 min-h-[34px] leading-relaxed">
            {plan.description}
          </p>

          <!-- Price Display -->
          <div class="mt-5 pb-5 border-b border-dashed border-primary/15 dark:border-neutral-700">
            <div class="flex items-baseline gap-1">
              <span class="text-sm font-semibold text-neutral-500 dark:text-neutral-400">¥</span>
              <span class="text-4xl md:text-5xl font-brand font-bold text-neutral-900 dark:text-neutral-100 tracking-tight">
                {plan.price}
              </span>
              <span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">
                {plan.period}
              </span>
            </div>
            <p class="mt-1 text-[11px] text-primary/80 dark:text-primary-light/80 font-medium">
              {plan.priceNote}
            </p>
          </div>

          <!-- Key Metrics Pills -->
          <div class="my-5 grid grid-cols-2 gap-2 text-center text-xs">
            <div class="p-2.5 rounded-xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/10 dark:border-neutral-700">
              <span class="block text-[10px] text-neutral-400">流量规格</span>
              <span class="block font-semibold text-neutral-800 dark:text-neutral-100 mt-0.5">{plan.traffic}</span>
            </div>
            <div class="p-2.5 rounded-xl bg-bg-primary/60 dark:bg-neutral-800/60 border border-primary/10 dark:border-neutral-700">
              <span class="block text-[10px] text-neutral-400">设备限制</span>
              <span class="block font-semibold text-emerald-600 dark:text-emerald-400 mt-0.5">{plan.devices}</span>
            </div>
          </div>

          <!-- Feature List -->
          <div class="space-y-2.5 text-xs text-neutral-600 dark:text-neutral-300 mb-6">
            <p class="text-[11px] font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">
              包含核心权益
            </p>
            {plan.features.map((feature) => (
              <div class="flex items-start gap-2">
                <span class:list={[
                  "mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full",
                  feature.highlight ? "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400" : "bg-neutral-200 dark:bg-neutral-700 text-neutral-500"
                ]}>
                  <Check size={11} stroke-width={2.5} />
                </span>
                <span class={feature.highlight ? "font-medium text-neutral-800 dark:text-neutral-100" : ""}>
                  {feature.text}
                </span>
              </div>
            ))}
          </div>

          <!-- Unlocks / Suitable -->
          <div class="pt-4 border-t border-dashed border-primary/15 dark:border-neutral-700 text-xs">
            <p class="text-[11px] font-semibold text-neutral-400 dark:text-neutral-500 mb-1.5">业务解锁能力</p>
            <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed text-[11px]">
              {plan.unlocks.slice(0, 3).join(" · ")}
            </p>
          </div>
        </div>

        <!-- Action Button -->
        <div class="mt-7">
          <Button
            url={REGISTER_URL}
            target="_blank"
            rel="nofollow noopener noreferrer"
            type={plan.popular ? "fill" : "solid"}
            className="w-full max-w-none justify-center py-3 text-sm font-semibold"
          >
            {plan.ctaText} <ArrowRight size={15} />
          </Button>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Clarification & Trust Strip -->
  <div class="mt-12 p-5 rounded-2xl border border-dashed border-primary/20 bg-primary/5 text-xs text-neutral-600 dark:text-neutral-300 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-primary/15 text-primary flex items-center justify-center shrink-0">
        <Shield size={18} />
      </div>
      <div>
        <p class="font-semibold text-neutral-800 dark:text-neutral-100">官方正版授权 · 100% 真实线路</p>
        <p class="text-neutral-500 dark:text-neutral-400 mt-0.5">全节点支持 VLESS 协议传输与 Clash、Shadowrocket 等主流客户端无缝导入，提供 7×24 专线运维保障。</p>
      </div>
    </div>
    <div class="shrink-0 flex items-center gap-2">
      <span class="text-neutral-400 text-[11px]">统一官方注册通道：</span>
      <a
        href={REGISTER_URL}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="inline-flex items-center gap-1 font-semibold text-primary dark:text-primary-light hover:underline"
      >
        进入官方用户中心 <ArrowRight size={14} />
      </a>
    </div>
  </div>
</section>
