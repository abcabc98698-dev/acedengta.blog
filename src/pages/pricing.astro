---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import PricingSection from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import { Check, X, ArrowRight, ShieldCheck, Sparkles, HelpCircle } from "@lucide/astro";

const comparisonFeatures = [
  { name: "价格与结算周期", p1: "147元 (一次性买断)", p2: "99元 / 年 (折合8.25元/月)", p3: "25元 / 月 (年付折后20元)", p4: "680元 / 月 (企业定制)" },
  { name: "流量规格", p1: "247 GB 永久不限期", p2: "69 GB / 月", p3: "168 GB / 月 (全节点×1)", p4: "500 GB / 月 (可扩容)" },
  { name: "网络线路架构", p1: "原生高速骨干专线", p2: "原生稳定专线", p3: "全球 IPLC 纯商业专线", p4: "全 IPLC 独享物理带宽" },
  { name: "单节点最高速率", p1: "2.5 Gbps", p2: "原生高速带宽", p3: "2.5 Gbps", p4: "2.5 Gbps 独立保障" },
  { name: "设备连接限制", p1: "不限设备数量", p2: "不限设备数量", p3: "不限设备数量", p4: "不限设备数量" },
  { name: "传输协议", p1: "VLESS 高效传输", p2: "VLESS 高效传输", p3: "VLESS 高效传输", p4: "VLESS / 按需定制" },
  { name: "节点覆盖区域", p1: "港/台/日/新/美/欧 等60+节点", p2: "港/台/日/新/马/美/欧", p3: "港/台/日/新/美/欧 等核心枢纽", p4: "港/日/美/新 全球按需定制" },
  { name: "4K 流媒体解锁", p1: "支持 (Netflix/Disney+)", p2: "支持 (Netflix/Disney+)", p3: "极致支持 (原生极速)", p4: "独享支持 (无风控风险)" },
  { name: "AI 工具加速", p1: "支持 (ChatGPT/Claude)", p2: "支持 (ChatGPT/Claude)", p3: "极速支持 (低时延秒回)", p4: "专属独立 IP (零封号风险)" },
  { name: "跨境电商 / TikTok直播", p1: "支持", p2: "基础支持", p3: "流畅支持", p4: "企业级高可靠支持" },
  { name: "专属原生独立 IP", p1: "共享原生 IP", p2: "共享原生 IP", p3: "共享纯净原生 IP", p4: "独享纯净专属原生 IP" },
  { name: "运维服务支持", p1: "工单 / 客户群", p2: "工单 / 客户群", p3: "7×24小时专业技术支持", p4: "7×24小时企业VIP专属支持" },
];

const pricingFaq = [
  {
    question: "“8.25 元/月”属于哪种套餐？",
    answer: "8.25 元/月是轻量版套餐年付 99 元计算得出的平均月费，非按月单次购买价格。年付方案适合查阅学术资料、日常办公沟通与偶尔观看流媒体的轻度用户。"
  },
  {
    question: "“致敬斯诺克147”套餐适合哪些人群？",
    answer: "适合用量不频繁、讨厌每月记账续费的用户。一次性付费 147 元即可获得 247GB 永久流量，没有月付清零压力，用完为止，支持作为长期主力或备用通道。"
  },
  {
    question: "极速版的多周期折扣是如何计算的？",
    answer: "极速版（原价 25元/月）提供阶梯优惠：半年付 9 折、年付 8 折（年付平均仅需 20元/月）、两年付 75 折、三年付 7 折，购买周期越长单月成本越划算。"
  },
  {
    question: "定制版包含哪些专属企业服务？",
    answer: "定制版（680元/月）专为对 IP 纯净度和稳定性有苛刻要求的出海电商、海外社媒投放团队与 TikTok 直播工作室设计。专属分配独立原生 IP 与独立保障带宽，不受其他邻居网络波动影响，并由工程师一对一确认线路地区和对接调试。"
  },
  {
    question: "付款后如何开通使用？",
    answer: "付款完成后系统在 10 秒内自动激活服务。您只需在用户中心一键复制订阅链接导入至自研客户端或 Clash、Shadowrocket 等软件即可使用。"
  },
];
---

<Layout
  title="套餐方案与价格详情 — 灯塔加速器官方品牌官网"
  description="灯塔加速器全系套餐方案展示。包含致敬斯诺克147永久套餐、99元年付轻量版、全球IPLC极速版与企业定制版。不限设备数量，原生稳定专线。"
>
  <section class="site-container my-12">
    <PageHeader
      title="透明、稳定、高性价比的专线方案"
      description="无隐藏套路，全系标配 VLESS 协议与原生高速专线，不限设备数量连接。"
    />
  </section>

  <!-- 4-Card Pricing Section -->
  <PricingSection showHeader={false} />

  <!-- Detailed Feature Comparison Table -->
  <section class="site-container my-16 md:my-24">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100">
        套餐详细规格横向对比
      </h2>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        一览四大方案的核心差异，挑选最契合您业务阶段的配置。
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-primary/15 dark:border-neutral-700 bg-bg-secondary/60 dark:bg-bg-secondary-dark/60 shadow-sm">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-primary/15 dark:border-neutral-700 bg-primary/5 dark:bg-primary/10">
            <th class="p-4 font-bold text-neutral-800 dark:text-neutral-200 min-w-[140px]">功能与规格对比</th>
            <th class="p-4 font-bold text-neutral-800 dark:text-neutral-200 min-w-[130px]">致敬斯诺克147</th>
            <th class="p-4 font-bold text-neutral-800 dark:text-neutral-200 min-w-[130px]">轻量版</th>
            <th class="p-4 font-bold text-primary dark:text-primary-light min-w-[130px]">极速版 (主力)</th>
            <th class="p-4 font-bold text-neutral-800 dark:text-neutral-200 min-w-[130px]">定制版</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-primary/10 dark:divide-neutral-700/60 text-neutral-600 dark:text-neutral-300">
          {comparisonFeatures.map((row) => (
            <tr class="hover:bg-primary/5 transition-colors">
              <td class="p-4 font-semibold text-neutral-800 dark:text-neutral-100">{row.name}</td>
              <td class="p-4">{row.p1}</td>
              <td class="p-4">{row.p2}</td>
              <td class="p-4 font-medium text-primary dark:text-primary-light">{row.p3}</td>
              <td class="p-4">{row.p4}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="site-container my-16">
    <FAQ
      title="购买与套餐相关常见问题"
      items={pricingFaq}
    />
  </section>

  <!-- CTA Box -->
  <section class="site-container my-16 text-center">
    <div class="p-8 sm:p-12 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20">
      <h3 class="text-2xl sm:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-3">
        准备好开启极致网络体验了吗？
      </h3>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6 max-w-lg mx-auto">
        进入官方统一注册通道，挑选适合您的套餐，几分钟即可畅游全球。
      </p>
      <Button
        url={REGISTER_URL}
        target="_blank"
        rel="nofollow noopener noreferrer"
        type="fill"
        className="px-8 py-3.5 font-semibold text-base mx-auto"
      >
        <Sparkles size={16} /> 前往官方注册开通 <ArrowRight size={16} />
      </Button>
    </div>
  </section>
</Layout>
