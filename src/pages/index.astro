---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/HeroSection.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Pricing from "@/components/sections/Pricing.astro";
import FAQ from "@/components/sections/FAQ.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import Button from "@/components/ui/Button.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import {
  ShieldCheck, Zap, Globe, Cpu, Laptop, Smartphone,
  CheckCircle2, ArrowRight, Lock, Activity, Sparkles, Server,
  Download, RefreshCw, KeyRound, Radio, Network
} from "@lucide/astro";

// FAQ 数据：真实、具体、诚恳，不制造虚假评分与假评论
const faqItems = [
  {
    question: "“8.25 元/月”是怎么计算出来的？",
    answer: "8.25 元/月属于“轻量版”年付套餐（99元/年）折算后的平均每月成本，并非普通的按月单月结算价格。年付方案适合需要长期稳定低成本办公、查阅资料与日常轻度娱乐的用户。"
  },
  {
    question: "灯塔加速器的线路质量如何？晚高峰会卡顿吗？",
    answer: "灯塔加速器自 2020 年起稳定运营，核心骨干采用全链路 IEPL 企业级内网专线与全球 IPLC 商业专线，数据直接经由内网物理通道过境，不挤公网拥堵隧道。全节点部署 VLESS 协议，单节点最高支持 2.5Gbps 带宽，实测在晚高峰时期丢包率接近于 0，保持毫秒级流畅响应。"
  },
  {
    question: "是否支持 ChatGPT、Claude 等 AI 工具及海外 4K 流媒体？",
    answer: "是的。品牌专线节点深度覆盖主流 AI 工具（ChatGPT / Claude / Midjourney）及海外 4K 流媒体（Netflix / Disney+ / YouTube / TikTok 国际版等）访问场景。由于流媒体与 AI 平台策略会动态变动，建议使用时结合节点标注进行优选。"
  },
  {
    question: "一个账号支持几台设备同时连接？",
    answer: "全系列套餐均享受“不限设备数量”政策。无论手机、平板、笔记本还是台式机，均可在同一账号下同时连接在线，非常适合个人全设备覆盖或团队多成员协同办公。"
  },
  {
    question: "支持哪些客户端软件？新手如何配置？",
    answer: "灯塔加速器提供官方自研客户端，免去复杂配置，一键登录即可直连；同时保留了极高灵活性的第三方订阅导入能力，完美兼容 Clash (Windows / macOS / Android)、Shadowrocket (iOS 小火箭)、Surge、Sing-box 等主流工具。官网用户中心与知识库均提供详尽的一对一图文指引。"
  },
  {
    question: "“致敬斯诺克147永久套餐”是真的永久不过期吗？",
    answer: "是的。“致敬斯诺克147”套餐为一次性买断永久版，内含 247GB 永久高速流量，流量用完即止，没有月付或年付到期清零的时间限制。特别适合轻度用量、备用网络或长期跨国通讯的用户。"
  },
];

// 产品优势六大维度
const features = [
  {
    icon: Zap,
    title: "IEPL 企业内网专线",
    desc: "全链路商业内网专线直连，物理过境避开公网风暴与晚高峰拥堵，丢包率极低，低至 12ms 极速响应。",
  },
  {
    icon: Cpu,
    title: "现代 VLESS 极速协议",
    desc: "全节点标配 VLESS 传输架构，轻量高效，去除冗余加密握手包，兼顾极高隐蔽性与毫秒级首包响应。",
  },
  {
    icon: Globe,
    title: "全球优质原生节点集群",
    desc: "精选香港×20、台湾×5、日本×10、新加坡×10、美国×10、欧洲等核心机房原生 IP，单节点最高 2.5Gbps。",
  },
  {
    icon: Sparkles,
    title: "流媒体 & AI 原生深度解锁",
    desc: "原生支持 Netflix、Disney+ 4K 超高清秒开，官方纯净 IP 畅行 ChatGPT、Claude 与 TikTok 电商直播。",
  },
  {
    icon: Laptop,
    title: "多端接入 · 不限设备数量",
    desc: "打破传统机场设备并发数限制，全系列套餐支持手机、平板、电脑多端同时在线，无并发门槛。",
  },
  {
    icon: ShieldCheck,
    title: "自研客户端 + 开放生态订阅",
    desc: "提供简易直连自研客户端，同时无缝兼容 Clash、Shadowrocket (小火箭) 等第三方主流订阅导入。",
  },
];

// 使用流程三步
const steps = [
  {
    step: "01",
    title: "进入官网注册并选购套餐",
    desc: "通过官方统一入口注册账号，根据业务需求选择永久版、年付轻量版或 IPLC 极速版套餐。",
  },
  {
    step: "02",
    title: "下载客户端或复制订阅",
    desc: "在官方用户中心下载自研客户端，或一键导入专属订阅到 Clash、Shadowrocket 等常用工具中。",
  },
  {
    step: "03",
    title: "一键连接，开启高速畅连",
    desc: "选择目标国家延迟最低的高速节点，开启系统代理，即可尽情畅享 4K 流媒体与全球生产力应用。",
  },
];

// 节点覆盖概览
const regions = [
  { name: "中国香港", count: "20+ 节点", ping: "10-25ms", tag: "超低时延 · 4K秒开", flag: "🇭🇰" },
  { name: "中国台湾", count: "5+ 节点", ping: "25-40ms", tag: "原生IP · 动画疯解锁", flag: "🇹🇼" },
  { name: "日本东京/大阪", count: "10+ 节点", ping: "35-50ms", tag: "国际骨干 · 游戏加速", flag: "🇯🇵" },
  { name: "新加坡", count: "10+ 节点", ping: "45-60ms", tag: "TikTok 直播电商专线", flag: "🇸🇬" },
  { name: "美国硅谷/洛杉矶", count: "10+ 节点", ping: "120-145ms", tag: "ChatGPT/Claude 原生", flag: "🇺🇸" },
  { name: "欧洲及其他地区", count: "多国节点", ping: "150-180ms", tag: "英/德/法/土/马/泰/巴西", flag: "🌐" },
];
---

<Layout
  title={siteConfig.meta.title}
  description={siteConfig.meta.description}
  keywords={siteConfig.meta.keywords}
>

  <!-- 1. 英雄区 -->
  <HeroSection />

  <!-- 2. 品牌信誉背书栏 -->
  <section class="py-8 bg-bg-secondary/60 dark:bg-bg-secondary-dark/60 border-y border-dashed border-primary/15 dark:border-neutral-700/80">
    <div class="site-container px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl sm:text-3xl font-brand font-bold text-primary dark:text-primary-light">2020 年</span>
          <span class="block text-xs text-neutral-500 dark:text-neutral-400 mt-1">品牌稳定运营至今</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-brand font-bold text-primary dark:text-primary-light">IEPL / IPLC</span>
          <span class="block text-xs text-neutral-500 dark:text-neutral-400 mt-1">企业级纯专线内网</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-brand font-bold text-primary dark:text-primary-light">2.5 Gbps</span>
          <span class="block text-xs text-neutral-500 dark:text-neutral-400 mt-1">单节点最高突发带宽</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-brand font-bold text-primary dark:text-primary-light">不限设备</span>
          <span class="block text-xs text-neutral-500 dark:text-neutral-400 mt-1">多终端同时在线畅连</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 产品核心优势展示 -->
  <section id="features" class="py-16 md:py-24 site-container">
    <SectionHeader
      title="为什么专业用户与出海团队选择灯塔加速器？"
      description="拒绝频繁掉线的廉价公网中继。以企业级专线与 VLESS 协议为基座，带来全时段稳定的网络服务。"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {features.map((item, index) => (
        <div
          class="p-6 sm:p-7 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700/80 hover:border-primary/30 transition-all duration-300 hover:-translate-y-1"
          data-aos="fade-up-sm"
          data-aos-delay={index * 80}
          data-aos-once="true"
        >
          <div class="w-12 h-12 rounded-xl bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light flex items-center justify-center mb-5">
            <item.icon size={24} />
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-2">
            {item.title}
          </h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. 4大卡片式套餐展示 -->
  <Pricing />

  <!-- 5. 全球原生节点覆盖 -->
  <section class="py-16 md:py-24 bg-bg-secondary/40 dark:bg-bg-secondary-dark/40 border-y border-dashed border-primary/15 dark:border-neutral-700/80">
    <div class="site-container">
      <SectionHeader
        title="全球优质骨干机房分布"
        description="广泛部署于亚太核心枢纽与欧美重要机房，全节点原生 IP 分配，满足多样化出海与跨境业务场景。"
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10">
        {regions.map((reg, idx) => (
          <div
            class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex items-start justify-between"
            data-aos="fade-up-xs"
            data-aos-delay={idx * 60}
            data-aos-once="true"
          >
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xl">{reg.flag}</span>
                <h4 class="font-bold text-neutral-800 dark:text-neutral-100 text-sm">{reg.name}</h4>
              </div>
              <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">{reg.count} · {reg.tag}</p>
            </div>
            <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              {reg.ping}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          * 实际网络时延受本地宽带营运商及物理距离影响，数据为沿海 IEPL 骨干入口平均实测值。
        </p>
      </div>
    </div>
  </section>

  <!-- 6. 使用流程：三步极速直连 -->
  <section id="workflow" class="py-16 md:py-24 site-container">
    <SectionHeader
      title="极简 3 步，开启高速国际网络"
      description="无论您使用自研客户端还是 Clash / Shadowrocket 等专业工具，配置均可在 2 分钟内轻松搞定。"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
      {steps.map((st, i) => (
        <div
          class="relative p-6 sm:p-7 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-dashed border-primary/25 dark:border-neutral-700"
          data-aos="fade-up-sm"
          data-aos-delay={i * 100}
          data-aos-once="true"
        >
          <span class="text-4xl font-brand font-bold text-primary/30 dark:text-primary/20 block mb-3">{st.step}</span>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-100 mb-2">{st.title}</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{st.desc}</p>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <Button
        url={REGISTER_URL}
        target="_blank"
        rel="nofollow noopener noreferrer"
        type="fill"
        className="px-8 py-3.5 font-semibold text-base mx-auto"
      >
        <Sparkles size={16} /> 立即前往官方注册开通 <ArrowRight size={16} />
      </Button>
    </div>
  </section>

  <!-- 7. 常见问题解答 FAQ -->
  <section id="faq" class="py-8 site-container">
    <FAQ
      title="常见疑问与解答"
      items={faqItems}
    />
  </section>

  <!-- 8. 官方知识库与 SEO 教程辅助入口 -->
  <div class="py-16 md:py-24 site-container border-t border-dashed border-primary/15 dark:border-neutral-700/80">
    <SectionHeader
      title="官方技术教程与使用指南"
      description="详尽的客户端配置教程、网络协议科普与流媒体加速最佳实践，助您轻松驾驭全球网络。"
    />
    <div class="mt-8">
      <BlogSection title="" limit={4} />
    </div>
  </div>

  <!-- 9. 底部品牌官方转化卡片 -->
  <section class="py-12 md:py-20 site-container mb-12">
    <div
      class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary via-primary-strong to-[#173a70] p-8 sm:p-12 text-center text-white shadow-xl shadow-primary/15"
      data-aos="fade-up-xs"
      data-aos-once="true"
    >
      <div class="max-w-2xl mx-auto">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/15 text-white backdrop-blur mb-4">
          <ShieldCheck size={14} /> 官方授权 · 7×24 专线运维
        </span>
        <h2 class="text-3xl sm:text-5xl font-brand font-bold mb-4 tracking-tight leading-tight">
          立即开通灯塔加速器
        </h2>
        <p class="text-base text-white/85 mb-8 leading-relaxed">
          体验自 2020 年沉淀的企业级 IEPL 专线品质。不限设备接入，单节点最高 2.5Gbps，年付低至 8.25 元/月。
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button
            url={REGISTER_URL}
            target="_blank"
            rel="nofollow noopener noreferrer"
            type="solid"
            className="text-base px-8 py-3.5 font-bold !text-primary hover:!text-primary-strong bg-white hover:bg-neutral-100"
          >
            立即注册开通 <ArrowRight size={16} />
          </Button>
          <Button url="/#pricing" type="outline" className="text-base px-8 py-3.5 font-bold !border-white/50 !text-white hover:!bg-white/10">
            查看套餐方案
          </Button>
        </div>
      </div>
    </div>
  </section>

</Layout>
