---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import { REGISTER_URL } from "@/config/site";
import {
  Zap, Cpu, Globe, Sparkles, Laptop, ShieldCheck,
  CheckCircle2, ArrowRight, Activity, Lock, RefreshCw, Network
} from "@lucide/astro";

const deepFeatures = [
  {
    icon: Zap,
    title: "企业级 IEPL / IPLC 纯内网专线",
    subtitle: "拒绝拥堵公网，物理专线直连过境",
    desc: "传统网络加速往往依赖公网国际出口，晚高峰时期极易受到运营商QoS限速与公网丢包风暴影响。灯塔加速器采用企业级 IEPL / IPLC 专线，骨干网络经由内网物理光纤过境，延迟抖动低于 3ms，全天候保障极致顺畅体验。",
    highlights: [
      "物理链路直通过境，跳过公网拥堵节点",
      "单节点最高突发带宽达 2.5 Gbps",
      "晚高峰实测丢包率趋近于 0%",
      "多入口 BGP 智能就近接入调度",
    ],
  },
  {
    icon: Cpu,
    title: "现代 VLESS 极速传输协议",
    subtitle: "更轻量、更纯粹、毫秒级首包响应",
    desc: "相较于陈旧繁杂的传统协议，VLESS 作为新一代无状态轻量化架构，精简了不必要的多重握手损耗，使首包交互延迟下降 40% 以上。配合底层专线保障，带来丝滑顺手的网页加载与即时通讯体验。",
    highlights: [
      "无多余握手数据包，响应迅速无感",
      "全节点统一部署，抗干扰能力极强",
      "完美兼容主流全平台代理核心",
      "低 CPU 占用，移动设备更省电",
    ],
  },
  {
    icon: Sparkles,
    title: "AI 原生工具 & 4K 流媒体深度支持",
    subtitle: "原生纯净住宅/机房 IP 分配，告别频繁验证码",
    desc: "ChatGPT、Claude、Midjourney 以及 Netflix、Disney+ 对访问者的 IP 质量与地理位置信誉度有着严格要求。灯塔加速器通过与全球一级 ISP 直接合作，部署大量原生纯净 IP，避免被云服务商标记黑名单，畅享 4K 极速秒开与高稳定性 AI 交互。",
    highlights: [
      "ChatGPT / Claude 对话毫秒即达，不弹人机验证",
      "Netflix / Disney+ / YouTube 4K/8K 满速拖拽",
      "TikTok 国际版出海营销与直播推流稳定不封控",
      "定期轮转与动态监测，保持节点高信誉值",
    ],
  },
  {
    icon: Laptop,
    title: "不限设备并发，多端同时在线",
    subtitle: "一个账号，覆盖您的所有个人设备或团队成员",
    desc: "我们深知现代用户拥有手机、平板、轻薄本、台式机等多种终端。灯塔加速器取消了苛刻的设备数量限制，全系列套餐均支持多端同时在线，随时随地在任何设备上延续极速网络体验。",
    highlights: [
      "零门槛多端协同，家庭与团队免二次加费",
      "支持 iOS、Android、Windows、macOS、Linux",
      "路由器全局代理支持",
      "会话独立并发，多端流量统计清晰明了",
    ],
  },
];
---

<Layout
  title="核心技术与产品优势 — 灯塔加速器官方品牌官网"
  description="深度解析灯塔加速器的核心优势：全IEPL企业专线、VLESS新一代协议、全球原生节点、4K流媒体与ChatGPT原生解锁、不限设备同时连接。"
>
  <section class="site-container my-12">
    <PageHeader
      title="卓越性能背后的技术架构"
      description="从物理专线到协议栈实现，灯塔加速器致力于为用户提供全天候高可用的出海网络基础设施。"
    />
  </section>

  <!-- Deep Features Grid -->
  <section class="site-container my-12 md:my-16 space-y-12">
    {deepFeatures.map((feat, index) => (
      <div
        class="p-8 sm:p-10 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/15 dark:border-neutral-700/80 shadow-sm"
        data-aos="fade-up-xs"
        data-aos-delay={index * 80}
        data-aos-once="true"
      >
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="w-14 h-14 rounded-2xl bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-light flex items-center justify-center shrink-0">
            <feat.icon size={28} />
          </div>
          <div class="flex-1">
            <div class="mb-3">
              <span class="text-xs font-semibold text-primary dark:text-primary-light uppercase tracking-wider">
                {feat.subtitle}
              </span>
              <h2 class="text-2xl sm:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mt-1">
                {feat.title}
              </h2>
            </div>
            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
              {feat.desc}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-dashed border-primary/15 dark:border-neutral-700">
              {feat.highlights.map((point) => (
                <div class="flex items-center gap-2 text-xs sm:text-sm text-neutral-700 dark:text-neutral-200">
                  <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
                  <span>{point}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </section>

  <!-- CTA Strip -->
  <section class="site-container my-16 text-center">
    <div class="p-8 sm:p-12 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20">
      <h3 class="text-2xl sm:text-3xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-3">
        体验企业级专线带来的流畅感
      </h3>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6 max-w-lg mx-auto">
        自 2020 年起稳定运营，单节点最高 2.5Gbps，支持自研客户端与主流第三方工具一键导入。
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button
          url={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          type="fill"
          className="px-8 py-3.5 font-semibold text-base"
        >
          <Sparkles size={16} /> 立即注册开通 <ArrowRight size={16} />
        </Button>
        <Button url="/#pricing" className="px-8 py-3.5 font-semibold text-base">
          查看套餐方案
        </Button>
      </div>
    </div>
  </section>
</Layout>
