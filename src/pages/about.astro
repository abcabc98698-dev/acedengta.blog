---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { ArrowRight, Heart, Code, Users, Compass } from "@lucide/astro";

const timeline = [
  {
    version: "v0.1",
    date: "2026年1月",
    title: "灯塔构想与技术原型",
    desc: "确立以零运行时、极速静态渲染与优雅设计令牌为核心的独立平台构想，完成核心页面骨架与明暗双色体系。",
  },
  {
    version: "v0.2",
    date: "2026年3月",
    title: "设计系统与交互深度打磨",
    desc: "全链路微调间距节奏、文字可读性与无障碍对比度，引入可复用视窗模拟组件与自然进入动效。",
  },
  {
    version: "v0.3",
    date: "2026年4月",
    title: "内容层架构升级",
    desc: "迁移至 Astro 6 Content Layer 现代内容底座，冷启动构建提速 30%，实现强类型 MDX 内容校验。",
  },
  {
    version: "v1.0",
    date: "2026年5月",
    title: "代码级纯净化与资产全独立",
    desc: "连根拔除克隆残留的全部暗桩、外部私人凭据与外链，规范化绝对路径 Canonical URL 与 JSON-LD 结构化数据，全站达成 Lighthouse 95+ 卓越基准。",
  },
];
---

<Layout
  title="关于我们 — Ace灯塔"
  description="了解 Ace灯塔：一座专注于现代前端工程、独立产品实践与数字化深度思考的技术灯塔。"
>
  <section class="site-container my-12">
    <PageHeader
      title="照亮独立技术与数字化产品的探索之路"
      description="我们专注于分享经过生产检验的前端架构、高效工程化工具与扎实的产品思考。代码完全自主，对搜索引擎深度友好。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-10">

      <!-- Why we built it -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">为什么创立 Ace灯塔</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            在开源世界中，充斥着两类极端：一类是徒有其表的“极简骨架”，稍加复杂需求便需要推倒重来；另一类则是堆砌数十个冗余依赖与第三方商业暗桩的臃肿体系，难以理清依赖关系与隐私归属。
          </p>
          <p>
            Ace灯塔致力于探索“纯净且具备生产级水准”的中间道路。我们坚持清晰的架构边界、零运行时优先的性能原则与完全自主可控的资产体系。
          </p>
          <p>
            我们选型 Astro 是因为其默认 Zero-JS 架构能为内容与营销站点带来绝佳的响应速度；选型 Tailwind CSS 是为了借力设计令牌（Design Tokens）实现极速的全局样式管控；选型 Instrument Serif 与 Inter 的字体搭配，则是为了在现代数字界面中注入一份克制的人文韵味。
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">我们恪守的原则</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Code class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">代码纯净与可维护</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">杜绝冗余暗桩与外部侵入式依赖。每一个组件与工具函数都遵循统一严谨的工程标准。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">用户与无障碍友好</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">严格校验色彩对比度与动效偏好设置，无论浅色还是深色模式均提供舒适自然的阅读体验。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Heart class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">深度原创与工匠精神</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">排版节奏、间距度量与交互微动效皆经深思熟虑，拒绝模板套用感与空洞的营销填空。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Compass class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">开放探索与技术沉淀</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">遵循清晰的开源许可，不搞技术绑架。让真实的经验与方法论成为开发者远航的指南针。</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">演进历程与里程碑</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Open source -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">加入交流与探索</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
          Ace灯塔致力于成为持续有生命力的技术生态。无论你是寻找灵感的开发者、全栈工程师，还是独立数字化产品创造者，都欢迎随时与我们建立连接。
        </p>
      </div>

      <div class="flex flex-wrap gap-4" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
        <Button url="/blog" type="fill">
          阅读最新文章 <ArrowRight size={16} />
        </Button>
        <Button url="/contact">
          联系我们
        </Button>
      </div>
    </article>
  </section>
</Layout>
