---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { REGISTER_URL } from "@/config/site";
import { ArrowRight, ShieldCheck, Heart, Zap, Globe, Compass, Users } from "@lucide/astro";

const history = [
  {
    year: "2020",
    title: "灯塔加速器创立",
    desc: "针对公网跨境网络频繁断流与晚高峰严重降速的痛点，团队搭建首批跨境专线测试节点，正式开启商业化运营。",
  },
  {
    year: "2022",
    title: "骨干网络全面升级为 IEPL 专线",
    desc: "全链路切入内网商业物理专线，接入香港、日本等亚太核心机房原生 IP，实现晚高峰 4K 流媒体秒开与超低时延。",
  },
  {
    year: "2024",
    title: "全面拥抱 VLESS 协议与自研生态",
    desc: "淘汰冗余旧协议，全节点标配现代 VLESS 架构；推出官方简易自研客户端，并完美保留 Clash、Shadowrocket 等主流第三方订阅导入生态。",
  },
  {
    year: "2026",
    title: "品牌官网全新升级 · 权威官方门户",
    desc: "全链路纯净化重构，建立正版官方品牌门户 acedengta.blog，规范化注册转化、透明套餐展示与专业知识库系统。",
  },
];
---

<Layout
  title="关于我们 — 灯塔加速器官方品牌官网"
  description="了解灯塔加速器的品牌起源与技术坚守。自 2020 年起稳定运营，专注于提供高品质 IEPL 企业专线与原生节点加速服务。"
>
  <section class="site-container my-12">
    <PageHeader
      title="以专业专线，照亮您的全球网络航路"
      description="始于 2020 年的稳健加速品牌。不玩弄价格套路，坚持以真实物理专线与原生 IP 为全球用户提供可信赖的服务。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24 space-y-12">
    <!-- Brand Story -->
    <article class="space-y-6 text-neutral-600 dark:text-neutral-300 leading-relaxed text-sm sm:text-base">
      <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 flex items-center gap-3 text-xs sm:text-sm font-medium">
        <ShieldCheck size={20} class="shrink-0 text-emerald-600 dark:text-emerald-400" />
        <span>官方正版授权认证：本站点为灯塔加速器品牌官方授权服务与信息发布门户。</span>
      </div>

      <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 pt-4">
        我们的品牌坚守
      </h2>
      <p>
        在过去数年间，加速市场涌现过无数追求极致低价、却在短短几个月后跑路失联的临时公网中继服务。公网隧道拥堵、高峰期剧烈卡顿、IP 被各大平台频繁风控，消耗了用户大量的试错成本。
      </p>
      <p>
        <strong>灯塔加速器</strong>自 2020 年诞生之初，便确立了“以线路品质为核心、以长期稳健为基准”的运营方向。我们并不单纯追求行业最低的营销标价，而是将资源扎实投入在全链路 IEPL / IPLC 企业专线采购与原生机房 IP 维护上，确保每一位用户的每一次连接都能得到稳定、纯净的保障。
      </p>
    </article>

    <div class="w-full border-b border-dashed border-primary/20 dark:border-neutral-700"></div>

    <!-- Core Values -->
    <div>
      <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-6">
        三大核心承诺
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
          <Zap class="w-6 h-6 text-primary mb-3" />
          <h3 class="font-bold text-neutral-800 dark:text-neutral-100 text-sm mb-1.5">纯专线不降级</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            核心主力节点全系采用内网商业物理专线，杜绝公网偷工减料，晚高峰依然保持稳定与高码率推流。
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
          <Users class="w-6 h-6 text-primary mb-3" />
          <h3 class="font-bold text-neutral-800 dark:text-neutral-100 text-sm mb-1.5">不限设备在线</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            全面打破单设备并发限制。一个账号即可满足全套个人数码设备或小微出海团队同时在线协同。
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
          <ShieldCheck class="w-6 h-6 text-primary mb-3" />
          <h3 class="font-bold text-neutral-800 dark:text-neutral-100 text-sm mb-1.5">真实数据透明</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
            不虚构虚假运营数字与假评论。节点倍率真实公示，8.25元/月年付折算说明清晰，诚信对待每一位用户。
          </p>
        </div>
      </div>
    </div>

    <div class="w-full border-b border-dashed border-primary/20 dark:border-neutral-700"></div>

    <!-- Timeline -->
    <div>
      <h2 class="text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-6">
        品牌发展轨迹 (2020 - 至今)
      </h2>
      <div class="relative pl-6 md:pl-8 border-l border-primary/20 dark:border-neutral-700 space-y-8">
        {history.map((item) => (
          <div class="relative">
            <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-mono text-xs font-bold text-primary dark:text-primary-light px-2 py-0.5 rounded bg-primary/10">
                {item.year}
              </span>
              <h3 class="font-bold text-neutral-800 dark:text-neutral-100 text-base">
                {item.title}
              </h3>
            </div>
            <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mt-1">
              {item.desc}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="pt-8 text-center border-t border-dashed border-primary/20 dark:border-neutral-700">
      <h3 class="text-xl sm:text-2xl font-brand font-bold text-neutral-800 dark:text-neutral-100 mb-3">
        选择值得长期托付的高速专线
      </h3>
      <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-6">
        进入官方统一通道，开启畅快无阻的全球网络体验。
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button
          url={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          type="fill"
          className="px-8 py-3.5 font-semibold text-base"
        >
          立即注册开通 <ArrowRight size={16} />
        </Button>
        <Button url="/#pricing" className="px-8 py-3.5 font-semibold text-base">
          查看套餐方案
        </Button>
      </div>
    </div>
  </section>
</Layout>
