---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import { ShieldCheck, Sparkles, CheckCircle2, ArrowRight, Zap, Gift, Lock } from "@lucide/astro";
---

<Layout
  title="官方用户注册通道 — 灯塔加速器品牌官网"
  description="灯塔加速器官方正版授权注册通道。新用户注册即享高速 IEPL 专线，不限设备，年付低至 8.25 元/月。"
>
  <main class="site-container py-12 md:py-20 flex items-center justify-center min-h-[75vh]">
    <div class="w-full max-w-xl mx-auto p-7 sm:p-10 rounded-3xl bg-bg-secondary dark:bg-bg-secondary-dark border-2 border-primary/20 shadow-xl shadow-primary/10 text-center" data-aos="fade-up-xs" data-aos-once="true">
      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 mb-4">
        <ShieldCheck size={14} />
        <span>灯塔加速器官方授权认证直通入口</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-brand font-bold text-neutral-900 dark:text-neutral-100 mb-3">
        进入官方统一注册中心
      </h1>
      <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-md mx-auto mb-8">
        为了保障您的账户安全、资金托管与专线带宽权益，请通过官方授权的安全通道完成账号开通。
      </p>

      <!-- Key Benefits Card -->
      <div class="p-4 rounded-2xl bg-bg-primary/80 dark:bg-neutral-800/80 border border-primary/10 dark:border-neutral-700 text-left space-y-2.5 mb-8 text-xs sm:text-sm">
        <div class="flex items-center gap-2 text-neutral-700 dark:text-neutral-200">
          <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
          <span>全链路 IEPL 企业级内网专线 · 晚高峰抗拥堵</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-700 dark:text-neutral-200">
          <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
          <span>原生支持 4K 流媒体与 ChatGPT / TikTok 业务</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-700 dark:text-neutral-200">
          <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
          <span>全套餐不限制客户端设备数量并发接入</span>
        </div>
        <div class="flex items-center gap-2 text-neutral-700 dark:text-neutral-200">
          <CheckCircle2 size={16} class="text-emerald-500 shrink-0" />
          <span>轻量入门年付低至 8.25 元/月 · 斯诺克永久买断版可选</span>
        </div>
      </div>

      <!-- Main CTA Button -->
      <div class="space-y-3">
        <Button
          url={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          type="fill"
          className="w-full max-w-none justify-center py-4 text-base font-bold shadow-lg shadow-primary/25"
        >
          <Sparkles size={18} /> 前往官方注册开通账户 <ArrowRight size={18} />
        </Button>
        <p class="text-[11px] text-neutral-400">
          已通过 256 位 SSL 安全链路跳转 · 不流失权重
        </p>
      </div>

      <!-- Existing Account Link -->
      <div class="mt-8 pt-6 border-t border-dashed border-primary/15 dark:border-neutral-700 flex items-center justify-center gap-2 text-xs text-neutral-500">
        <span>已有灯塔账号？</span>
        <a
          href={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="font-semibold text-primary dark:text-primary-light hover:underline"
        >
          直接登录用户中心
        </a>
      </div>
    </div>
  </main>
</Layout>
