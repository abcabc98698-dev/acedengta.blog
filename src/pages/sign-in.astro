---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import { ShieldCheck, ArrowRight, Sparkles, UserCheck } from "@lucide/astro";
---

<Layout
  title="用户中心登录 — 灯塔加速器品牌官网"
  description="灯塔加速器官方授权用户中心登录入口。查看订阅信息、获取客户端节点与续费管理。"
>
  <main class="site-container py-12 md:py-20 flex items-center justify-center min-h-[75vh]">
    <div class="w-full max-w-lg mx-auto p-7 sm:p-10 rounded-3xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/20 shadow-xl shadow-primary/10 text-center" data-aos="fade-up-xs" data-aos-once="true">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 mb-4">
        <ShieldCheck size={14} />
        <span>官方授权统一认证中心</span>
      </div>

      <h1 class="text-3xl font-brand font-bold text-neutral-900 dark:text-neutral-100 mb-2">
        登录灯塔加速器用户中心
      </h1>
      <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-8">
        管理您的套餐订阅、获取最新节点配置、下载自研或第三方客户端。
      </p>

      <div class="space-y-4">
        <Button
          url={REGISTER_URL}
          target="_blank"
          rel="nofollow noopener noreferrer"
          type="fill"
          className="w-full max-w-none justify-center py-3.5 text-base font-bold shadow-md shadow-primary/20"
        >
          <UserCheck size={18} /> 进入官方用户中心登录 <ArrowRight size={18} />
        </Button>
      </div>

      <div class="mt-8 pt-6 border-t border-dashed border-primary/15 dark:border-neutral-700 text-xs text-neutral-500">
        <span>尚未开通账户？</span>
        <a
          href="/sign-up"
          class="font-semibold text-primary dark:text-primary-light hover:underline ml-1"
        >
          立即前往官方注册开通
        </a>
      </div>
    </div>
  </main>
</Layout>
