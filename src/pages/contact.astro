---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig, REGISTER_URL } from "@/config/site";
import { ArrowRight, Clock3, LifeBuoy, Mail, MessageSquare, Send, Sparkles, ShieldCheck, Ticket } from "@lucide/astro";

const contactTopics = [
  { value: "general", label: "账户注册与开通咨询" },
  { value: "setup", label: "客户端配置与订阅导入指导" },
  { value: "custom", label: "企业定制版（独享原生IP）需求洽谈" },
  { value: "business", label: "商务合作与企业采购" },
];

const channels = [
  {
    icon: Ticket,
    label: "官方用户中心工单 (推荐)",
    text: "登录控制台提交工单，技术专员优先处理",
    href: REGISTER_URL,
    isExternal: true,
  },
  {
    icon: Mail,
    label: "官方客服邮箱",
    text: siteConfig.mail,
    href: `mailto:${siteConfig.mail}`,
    isExternal: false,
  },
  {
    icon: MessageSquare,
    label: "官方 Telegram 频道",
    text: "第一时间获取节点扩容与维护通知",
    href: siteConfig.social.telegram,
    isExternal: true,
  },
];
---

<Layout
  title="客户支持与官方联系 — 灯塔加速器官方品牌官网"
  description="灯塔加速器官方客户支持门户。提供 7×24 小时工单技术支持、客户端配置解答及企业定制专线咨询。"
>
  <main class="site-container py-12 md:py-20">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] lg:items-start">
      <div data-aos="fade-up-xs" data-aos-once="true">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/15 bg-primary/5 px-3 py-1 text-xs font-medium text-primary dark:border-primary-light/20 dark:bg-primary-light/10 dark:text-primary-light">
          <Sparkles size={14} />
          官方专业支持
        </p>
        <h1 class="max-w-xl font-brand text-4xl leading-tight tracking-normal text-neutral-800 dark:text-neutral-100 sm:text-5xl lg:text-6xl font-bold">
          竭诚为您提供 7×24 专业网络支持
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-neutral-600 dark:text-neutral-300">
          无论您是在客户端配置过程中遇到疑问，还是需要为跨境企业团队定制独享专线带宽，我们都将为您提供详尽清晰的解答。
        </p>

        <div class="mt-10 grid gap-3.5">
          {channels.map(({ icon: Icon, label, text, href, isExternal }, index) => (
            <a
              href={href}
              target={isExternal ? "_blank" : "_self"}
              rel={isExternal ? "nofollow noopener noreferrer" : undefined}
              class="group flex items-center gap-4 rounded-2xl border border-neutral-200 bg-bg-secondary/75 p-4 sm:p-5 transition-all hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-md dark:border-neutral-700 dark:bg-bg-secondary-dark/75"
              data-aos="fade-up-xs"
              data-aos-delay={`${index * 100}`}
              data-aos-once="true"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-primary shadow-sm ring-1 ring-neutral-200/70 transition-colors group-hover:bg-primary group-hover:text-white dark:bg-neutral-900/60 dark:text-primary-light dark:ring-neutral-700">
                <Icon size={20} />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-neutral-800 dark:text-neutral-100">{label}</span>
                <span class="mt-0.5 block truncate text-xs text-neutral-500 transition-colors group-hover:text-primary dark:text-neutral-400">{text}</span>
              </span>
              <ArrowRight class="ml-auto h-4 w-4 shrink-0 text-neutral-300 transition-all group-hover:translate-x-1 group-hover:text-primary dark:text-neutral-600" />
            </a>
          ))}
        </div>

        <div class="mt-8 p-4 rounded-xl border border-dashed border-primary/20 bg-primary/5 text-xs text-neutral-600 dark:text-neutral-400 space-y-1">
          <p class="font-semibold text-primary dark:text-primary-light flex items-center gap-1.5">
            <Clock3 size={14} /> 服务响应周期承诺
          </p>
          <p>官方工单支持在正常工作时段内通常于 30 分钟内回复，节假日与夜间工单将于 2-4 小时内处理。</p>
        </div>
      </div>

      <!-- Quick Message Form -->
      <div class="mx-auto w-full max-w-xl lg:max-w-none" data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <div class="rounded-3xl border border-neutral-200 bg-bg-secondary/85 p-6 shadow-xl shadow-primary/5 backdrop-blur dark:border-neutral-700 dark:bg-bg-secondary-dark/85 sm:p-8">
          <div class="mb-7 flex flex-col gap-2 border-b border-dashed border-neutral-200 pb-6 dark:border-neutral-700">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary dark:text-primary-light">在线咨询</p>
            <h2 class="font-brand text-3xl font-bold text-neutral-800 dark:text-neutral-100">快速留言与反馈</h2>
            <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400">
              请留下您的疑问或商务诉求，我们会在第一时间通过邮件与您联系。
            </p>
          </div>

          <form id="contact-form" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-1.5 block text-xs font-semibold text-neutral-700 dark:text-neutral-300">您的称呼</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="如何称呼您"
                  class="contact-field text-sm"
                />
              </div>

              <div>
                <label for="email" class="mb-1.5 block text-xs font-semibold text-neutral-700 dark:text-neutral-300">联系邮箱</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="yourname@domain.com"
                  class="contact-field text-sm"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="mb-1.5 block text-xs font-semibold text-neutral-700 dark:text-neutral-300">咨询分类</label>
              <select id="subject" name="subject" required class="contact-field text-sm">
                <option value="">请选择咨询分类</option>
                {contactTopics.map((topic) => (
                  <option value={topic.value}>{topic.label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="message" class="mb-1.5 block text-xs font-semibold text-neutral-700 dark:text-neutral-300">详细描述</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="请详细描述您的需求、问题复现步骤或定制方案细节..."
                class="contact-field resize-none text-sm"
              ></textarea>
            </div>

            <div class="form-submit-btn pt-2">
              <button type="submit" class="w-full justify-center py-3 text-sm font-semibold rounded-xl bg-btn-primary hover:bg-btn-primary-hover text-white shadow-sm transition-all duration-200 cursor-pointer">
                提交留言信息 <Send size={15} />
              </button>
            </div>

            <div id="form-success" class="hidden rounded-xl border border-green-200 bg-green-50 p-4 text-center text-xs sm:text-sm font-medium text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-300">
              您的留言已成功提交，技术专员将尽快查阅并回复您。
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-field {
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-neutral-200);
    background: color-mix(in srgb, var(--color-bg-secondary) 82%, transparent);
    padding: 0.75rem 1rem;
    color: var(--color-neutral-800);
    outline: none;
    transition: all 180ms ease;
  }
  .contact-field:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }
  :global(.dark) .contact-field {
    border-color: var(--color-neutral-700);
    background: color-mix(in srgb, var(--color-bg-secondary-dark) 82%, transparent);
    color: var(--color-neutral-100);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const submitBtn = form?.querySelector('.form-submit-btn a') as HTMLAnchorElement | null;

  submitBtn?.addEventListener('click', (event) => {
    event.preventDefault();
    if (!form?.checkValidity()) {
      form?.reportValidity();
      return;
    }
    successMsg?.classList.remove('hidden');
    form.reset();
    setTimeout(() => {
      successMsg?.classList.add('hidden');
    }, 5000);
  });
</script>
