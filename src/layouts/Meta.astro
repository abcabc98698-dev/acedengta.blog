---
import { siteConfig } from '@/config/site.js';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  url?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishDate?: Date | string;
  twitterHandle?: string;
  robots?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const {
  title = siteConfig.meta.title,
  description = siteConfig.meta.description,
  keywords = siteConfig.meta.keywords,
  url,
  ogImage = siteConfig.meta.image || "/og.jpg",
  ogType = "website",
  publishDate,
  twitterHandle = siteConfig.meta.twitterHandle || siteConfig.social.twitterName || '',
  robots = "index, follow",
  faqs = [],
} = Astro.props;

// Canonical URL calculation
const canonicalURL = url ? new URL(url, siteConfig.url).href : new URL(Astro.url.pathname, siteConfig.url).href;
const formattedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteConfig.url).href;

// Breadcrumb Schema
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "首页",
    "item": siteConfig.url
  }
];

if (pathSegments.length > 0) {
  let accumulatedPath = '';
  pathSegments.forEach((segment, index) => {
    accumulatedPath += `/${segment}`;
    let name = segment;
    if (segment === 'blog') name = '官方指南与知识库';
    else if (segment === 'pricing') name = '套餐方案与选型';
    else if (segment === 'features') name = '核心技术架构';
    else if (segment === 'status') name = '集群实时状态';
    else if (segment === 'about') name = '关于我们';
    else if (segment === 'contact') name = '客户服务支持';
    else if (segment === 'privacy') name = '隐私政策';
    else if (segment === 'terms') name = '服务条款';
    else if (index === pathSegments.length - 1 && title) name = title.split('—')[0].split('|')[0].trim();

    breadcrumbItems.push({
      "@type": "ListItem",
      "position": index + 2,
      "name": name,
      "item": new URL(accumulatedPath, siteConfig.url).href
    });
  });
}

const breadcrumbSchema = pathSegments.length > 0 ? {
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
} : null;

// FAQ Schema
const faqSchema = faqs && faqs.length > 0 ? {
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// Main Entity Schema
const mainEntity = ogType === 'article'
  ? {
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "image": formattedOgImage,
      "datePublished": publishDate ? new Date(publishDate).toISOString() : undefined,
      "author": {
        "@type": "Person",
        "name": siteConfig.author,
        "url": siteConfig.url
      },
      "publisher": {
        "@type": "Organization",
        "name": siteConfig.title,
        "url": siteConfig.url,
        "logo": {
          "@type": "ImageObject",
          "url": new URL("/assets/logo.png", siteConfig.url).href
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL
      }
    }
  : {
      "@type": "WebSite",
      "name": siteConfig.title,
      "url": siteConfig.url,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": siteConfig.title,
        "url": siteConfig.url
      }
    };

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [mainEntity, breadcrumbSchema, faqSchema].filter(Boolean)
};
---

<!-- Basic Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content={robots} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />

<!-- Open Graph Tags -->
<meta property="og:locale" content="zh_CN" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={formattedOgImage} />
<meta property="og:image:alt" content={title} />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={formattedOgImage} />
{twitterHandle && (
  <>
    <meta name="twitter:site" content={`@${twitterHandle}`} />
    <meta name="twitter:creator" content={`@${twitterHandle}`} />
  </>
)}

<!-- Structured Data (JSON-LD) with @graph hierarchy -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
